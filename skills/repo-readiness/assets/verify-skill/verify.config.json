{
  "kit": "dev-skills repo-readiness <version or commit copied from>",
  "index": "features/README.md",
  "mapRoots": ["docs"],
  "entries": {
    "api": {
      "name": "API",
      "adapter": "scripts/entries/http-service.mjs",
      "options": {
        "command": ["node", "{root}/server.js", "--port", "{port}", "--data", "{dataDir}"],
        "health": "/health",
        "identity": { "field": "runId", "equals": "{runId}" },
        "env": { "NODE_ENV": "test" },
        "builds": [],
        "readySeconds": 60,
        "invalidWhen": "^AUTH LOST",
        "sideEffectReads": []
      }
    },
    "web": {
      "name": "Web",
      "ui": true,
      "max": 4,
      "adapter": "scripts/entries/http-service.mjs",
      "options": {
        "command": ["node", "{root}/server.js", "--port", "{port}", "--data", "{dataDir}"],
        "health": "/health",
        "readySeconds": 60
      }
    },
    "cli": {
      "name": "CLI",
      "adapter": "scripts/entries/cli.mjs",
      "options": {
        "command": ["node", "{root}/bin/cli.js"],
        "dirs": [],
        "env": {},
        "builds": [],
        "pidRecords": [],
        "keep": [],
        "sideEffectCommands": []
      }
    }
  },
  "scripted": [],
  "jobs": 8,
  "runsRoot": null,
  "headings": {
    "subfeatures": "Sub-features",
    "steps": "Drive",
    "uncovered": "Not covered",
    "scriptedColumn": "Also scripted",
    "runRecord": ["Run record"]
  },
  "lookMarker": "(look)"
}
